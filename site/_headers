# Netlify response headers. Ignored by other hosts (harmless).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self'; style-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/data/*
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

# Code and styles: always re-check with the server, so a new deploy shows up immediately.
/assets/js/*
  Cache-Control: no-cache

/assets/css/*
  Cache-Control: no-cache

# Fonts, libraries and images rarely change.
/assets/fonts/*
  Cache-Control: public, max-age=86400

/assets/vendor/*
  Cache-Control: public, max-age=86400

/assets/img/*
  Cache-Control: public, max-age=86400
